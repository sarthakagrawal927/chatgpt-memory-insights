---
import { publicPages } from "../data/public-identity";
import { indexCopy, chatgptExportSteps, privacyContract } from "../data/public-content";
import "@saas-maker/insight-atlas/styles.css";
import MemoryAtlas from "@saas-maker/insight-atlas/MemoryAtlas.astro";
import StudioFooter from "../components/studio-footer.astro";

const { title, description } = publicPages.index;
const siteUrl = "https://chatgpt.significanthobbies.com/";
const socialImage =
  "https://raw.githubusercontent.com/sarthakagrawal927/chatgpt-memory-insights/main/artifacts/design/after-1440.png";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "Memory Map",
      url: siteUrl,
      description,
    },
    {
      "@type": "SoftwareApplication",
      name: "Memory Map",
      url: siteUrl,
      description,
      applicationCategory: "LifestyleApplication",
      operatingSystem: "Any modern web browser",
      featureList: [
        "Browser-local ChatGPT export analysis",
        "Evidence-linked recurring themes and questions",
        "Historical memory and topic shifts",
        "Optional browser-local semantic search and Memory Chat",
      ],
    },
  ],
};
---

<!--
THESIS: Conversation history becomes a navigable memory network, not a dashboard of vanity totals.
OWN-WORLD: Cool paper, ink rules, colored transit routes, labelled interchanges, and evidence-ledger rows.
STORY: Import privately, see the map form, search it, then inspect the sources behind every suggestion.
FIRST VIEWPORT: Before import, one route gate. After import, search and the semantic graph dominate with a fact ledger at right.
FORM: Graph-first memory workbench; selected delegated probe; direction seed 100c1b70, grounded candidate five with transit-stack staging.
-->

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="ai-summary" content={description} />
    <link rel="alternate" type="text/markdown" href="https://chatgpt.significanthobbies.com/index.md" />
    <meta name="theme-color" content="#f3f5f2" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Memory Map" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
